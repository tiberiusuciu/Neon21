generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  nameChosen       Boolean        @default(false)
  email            String         @unique
  passwordHash     String?
  googleId         String?        @unique
  balanceCents     Int            @default(10000)
  lastClaimAt      DateTime?
  handsPlayed      Int            @default(0)
  wins             Int            @default(0)
  losses           Int            @default(0)
  pushes           Int            @default(0)
  blackjacks       Int            @default(0)
  biggestWinCents  Int            @default(0)
  biggestLossCents Int            @default(0)
  netProfitCents   Int            @default(0)
  /** Hands completed while Golden Hour was active (lifetime). */
  goldenHourHandsPlayed Int       @default(0)
  /** Spendable Golden Hand tokens. */
  goldenHands      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  handOutcomes     HandOutcome[]
  spinVouchers     SpinVoucher[]
  jackpotClaims    JackpotClaim[]
}

model HandOutcome {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultCents      Int
  betCents         Int
  isBlackjack      Boolean  @default(false)
  doubled          Boolean  @default(false)
  bust             Boolean  @default(false)
  /** Side bet — counted in net/jackpot, not in handsPlayed W/L. */
  isInsurance      Boolean  @default(false)
  /** Wallet balance after this outcome settled (null on legacy rows). */
  balanceAfterCents Int?
  /** Cents contributed to the jackpot vault from this outcome (0 if win/push). */
  jackpotTakeCents Int @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isBlackjack, createdAt])
  @@index([createdAt, jackpotTakeCents])
}

model SpinVoucher {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String        @default("open")
  createdAt DateTime      @default(now())
  usedAt    DateTime?
  claim     JackpotClaim?

  @@index([userId, status])
  @@index([userId, createdAt])
}

model JackpotClaim {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName       String
  tableId        String
  tableName      String
  voucherId      String      @unique
  voucher        SpinVoucher @relation(fields: [voucherId], references: [id])
  tileIndex      Int
  kind           String
  pctBps         Int         @default(0)
  payoutCents    Int
  potBeforeCents Int
  /** Non-cash wheel prizes (e.g. Golden Hands tile). */
  goldenHandsGranted Int     @default(0)
  createdAt      DateTime    @default(now())

  @@index([createdAt])
}

/** Admin (or system) ledger rows so available pot can be set without faking losses/claims. */
model JackpotAdjustment {
  id         String   @id @default(cuid())
  deltaCents Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/** Singleton schedule for the Golden Hour event. */
model GoldenHourState {
  id              String    @id @default("golden_hour")
  disabled        Boolean   @default(false)
  activeUntil     DateTime?
  nextStartsAt    DateTime?
  windowStartedAt DateTime?
  /** Inclusive min hours between windows (admin-tunable). */
  cooldownMinHours Int      @default(4)
  /** Inclusive max hours between windows (admin-tunable). */
  cooldownMaxHours Int      @default(12)
  /** GH hands needed to earn one Golden Hand (admin-tunable). */
  goldenHandsPerHands Int    @default(15)
  updatedAt       DateTime  @updatedAt
}

/** Per-player gross losses for one Golden Hour window (rebate basis). */
model GoldenHourPlayerStats {
  id              String   @id @default(cuid())
  userId          String
  windowStartedAt DateTime
  wonCents        Int      @default(0)
  lostCents       Int      @default(0)
  rebatePaidCents Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, windowStartedAt])
  @@index([windowStartedAt])
}

model Table {
  id           String   @id @default(cuid())
  name         String   @unique
  seatCapacity Int      @default(5)
  status       String   @default("open")
  createdAt    DateTime @default(now())
}

/** tableId is the live game room id (not necessarily a row in Table). */
model TableChatMessage {
  id        String   @id @default(cuid())
  tableId   String
  userId    String
  name      String
  text      String
  kind      String   @default("chat")
  createdAt DateTime @default(now())

  @@index([tableId, createdAt])
}
