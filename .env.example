POSTGRES_USER=neon21
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=neon21
# Compose overrides host to `db`. For host-side scripts use localhost:
# DATABASE_URL=postgresql://neon21:change_me_strong_password@localhost:5432/neon21
DATABASE_URL=postgresql://neon21:change_me_strong_password@db:5432/neon21
JWT_SECRET=change_me_generate_a_long_random_string
ADMIN_EMAIL=
# Staging only — enables table debug sockets (force bet, scripted cards, bots). Never on prod.
ALLOW_TABLE_DEBUG=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
PORT=4000
CORS_ORIGIN=http://localhost:5173
HOST=0.0.0.0
# Optional ISO datetime — jackpot ignores HandOutcomes before this (default baked into server).
# JACKPOT_STARTS_AT=2026-09-23T20:40:00.000Z

# Frontend (apps/web/.env) — Vite only reads VITE_* from apps/web:
# VITE_API_URL=http://localhost:4000
# VITE_STAGING=true
